# dev.to
# Obtener en: https://dev.to/settings/extensions → DEV Community API Keys
DEVTO_API_KEY=rL5kxNx2nsUWxH5Z9mwgFQzi

# LinkedIn
# Obtener en: https://www.linkedin.com/developers/apps → OAuth 2.0 → Access token
# Requiere permisos w_member_social. El token expira en 60 días — renovar.
LINKEDIN_ACCESS_TOKEN=
# Tu URN de LinkedIn: urn:li:person:XXXXXXXX
# Obtener con: curl -H "Authorization: Bearer TOKEN" https://api.linkedin.com/v2/userinfo → campo "sub"
LINKEDIN_AUTHOR_URN=

# URL base del sitio (Netlify la inyecta automáticamente en producción)
