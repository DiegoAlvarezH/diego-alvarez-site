---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { getLangFromUrl, useTranslations, localePath } from '@/i18n/utils';
import { getLocalized, stripLang, getCover } from '@/i18n/content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// TOC: solo h2 — los h3 del cierre ("Fuentes") no aportan navegación
const toc = headings.filter((h) => h.depth === 2);

// Anterior = más antiguo, siguiente = más reciente (por `order`)
const posts = await getLocalized('blog', lang);
const idx = posts.findIndex((p) => p.id === post.id);
const prev = idx > 0 ? posts[idx - 1] : null;
const next = idx < posts.length - 1 ? posts[idx + 1] : null;
const postHref = (id: string) => localePath(lang, `/blog/${stripLang(id)}`);
---

<BaseLayout
  title={`${post.data.title} — Diego Alvarez`}
  description={post.data.description}
  image={getCover(post)}
  type="article"
>
  <main class="bg-bg min-h-screen">
    <div class="max-w-[1080px] mx-auto px-6 pt-32 pb-24 xl:grid xl:grid-cols-[minmax(0,720px)_220px] xl:justify-center xl:gap-16">
    <article class="max-w-[720px] mx-auto xl:mx-0 w-full">
      <a
        href={localePath(lang, '/blog')}
        class="group font-mono text-accent-ink text-[11px] tracking-[2px] uppercase flex items-center gap-2 mb-12 no-underline w-fit"
      >
        <span class="transition-transform duration-150 group-hover:-translate-x-1">←</span>
        {t('blog.backToBlog')}
      </a>

      <header class="reveal">
        <div class="flex items-center gap-3 mb-4 flex-wrap">
          <span class="font-mono text-[8px] tracking-[3px] uppercase px-2 py-1 text-accent-ink border border-accent-ink rounded-[2px]">
            {post.data.tag}
          </span>
          <span class="font-mono text-text-3 flex items-center gap-1 text-[10px]">
            <Icon name="clock" size={10} />
            {post.data.readTime}
          </span>
          <span class="font-mono text-text-3 text-[10px]">{post.data.date}</span>
        </div>
        <h1 class="font-sans font-extrabold text-white" style="font-size: clamp(30px, 5vw, 44px); letter-spacing: -1.5px; line-height: 1.1;">
          {post.data.title}
        </h1>
        <p class="text-text-2 mt-4 text-[16px] leading-relaxed">{post.data.description}</p>
      </header>

      <hr class="border-border my-10" />

      <div class="prose-dark">
        <Content />
      </div>

      {
        (prev || next) && (
          <nav class="mt-16 pt-10 border-t border-border grid grid-cols-1 sm:grid-cols-2 gap-3" aria-label="Posts">
            {prev ? (
              <a
                href={postHref(prev.id)}
                class="group block p-5 border border-border rounded-[4px] bg-surface transition-colors duration-200 hover:border-accent-ink no-underline"
              >
                <span class="font-mono text-[9px] tracking-[3px] uppercase text-text-3 flex items-center gap-2">
                  <span class="text-accent-ink transition-transform duration-150 group-hover:-translate-x-1">←</span>
                  {t('blog.prev')}
                </span>
                <span class="block text-white text-[14px] font-semibold leading-snug mt-2">{prev.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a
                href={postHref(next.id)}
                class="group block p-5 border border-border rounded-[4px] bg-surface transition-colors duration-200 hover:border-accent-ink no-underline sm:text-right"
              >
                <span class="font-mono text-[9px] tracking-[3px] uppercase text-text-3 flex items-center gap-2 sm:justify-end">
                  {t('blog.next')}
                  <span class="text-accent-ink transition-transform duration-150 group-hover:translate-x-1">→</span>
                </span>
                <span class="block text-white text-[14px] font-semibold leading-snug mt-2">{next.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>

    {
      toc.length > 2 && (
        <aside class="hidden xl:block">
          <nav class="sticky top-28" aria-label={t('blog.toc')}>
            <p class="font-mono text-accent-ink uppercase text-[9px] tracking-[4px] mb-4">{t('blog.toc')}</p>
            <ul class="toc-list border-l border-border">
              {toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    data-toc-link={h.slug}
                    class="block -ml-px pl-4 py-1.5 border-l border-transparent text-[12px] leading-snug text-text-2 hover:text-text-1 transition-colors duration-150 no-underline"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
    </div>
  </main>
</BaseLayout>

<style is:global>
  /* Tipografía de artículo — paleta del sitio, sin plugin typography */
  .prose-dark {
    color: var(--c-prose);
    font-size: 16px;
    line-height: 1.75;
  }
  .prose-dark h2 {
    color: var(--c-text-1);
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.5px;
    margin: 2.5rem 0 1rem;
  }
  .prose-dark h3 {
    color: var(--c-text-1);
    font-weight: 700;
    font-size: 19px;
    margin: 2rem 0 0.75rem;
  }
  .prose-dark p {
    margin: 1rem 0;
  }
  .prose-dark a {
    color: var(--c-accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-dark strong {
    color: var(--c-text-1);
  }
  .prose-dark em {
    color: var(--c-prose-em);
  }
  .prose-dark ul,
  .prose-dark ol {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }
  .prose-dark ul {
    list-style: disc;
  }
  .prose-dark ol {
    list-style: decimal;
  }
  .prose-dark li {
    margin: 0.4rem 0;
  }
  .prose-dark li::marker {
    color: var(--c-accent-ink);
  }
  .prose-dark code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13.5px;
    background: var(--c-surface-2);
    border: 1px solid var(--c-border);
    border-radius: 3px;
    padding: 2px 6px;
    color: var(--c-accent-ink);
  }
  .prose-dark pre {
    background: var(--c-surface) !important;
    border: 1px solid var(--c-border);
    border-radius: 4px;
    padding: 1.25rem;
    margin: 1.5rem 0;
    overflow-x: auto;
  }
  .prose-dark pre code {
    background: transparent;
    border: none;
    padding: 0;
    color: inherit;
    font-size: 13px;
  }
  .prose-dark blockquote {
    border-left: 2px solid var(--c-accent-ink);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--c-text-2);
    font-style: italic;
  }
  .prose-dark hr {
    border-color: var(--c-border);
    margin: 2.5rem 0;
  }
  .prose-dark h2,
  .prose-dark h3 {
    scroll-margin-top: 96px;
  }
  .prose-dark table {
    width: 100%;
    margin: 1.75rem 0;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 1.5;
    display: block;
    overflow-x: auto;
  }
  .prose-dark th,
  .prose-dark td {
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--c-border);
    text-align: left;
    vertical-align: top;
  }
  .prose-dark thead th {
    background: var(--c-surface-2);
    color: var(--c-text-1);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .prose-dark tbody tr:nth-child(even) td {
    background: var(--c-surface);
  }
  .toc-list a.is-active {
    color: var(--c-text-1);
    border-left-color: var(--c-accent-ink);
  }
  .prose-dark img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--c-border);
    border-radius: 8px;
    margin: 1.5rem 0 2.5rem;
  }
</style>

<script>
  // Resalta en el TOC la última sección cuyo título ya pasó bajo el nav
  let tocHeadings: HTMLElement[] = [];
  let tocLinks: NodeListOf<HTMLAnchorElement> | null = null;
  let tocTicking = false;

  function updateToc() {
    tocTicking = false;
    if (!tocLinks?.length) return;
    let current = tocHeadings[0]?.id;
    for (const h of tocHeadings) {
      if (h.getBoundingClientRect().top <= 140) current = h.id;
      else break;
    }
    tocLinks.forEach((l) => l.classList.toggle('is-active', l.dataset.tocLink === current));
  }

  function initToc() {
    tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    tocHeadings = [...tocLinks]
      .map((l) => document.getElementById(l.dataset.tocLink!))
      .filter((el): el is HTMLElement => el !== null);
    updateToc();
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!tocTicking) {
        tocTicking = true;
        requestAnimationFrame(updateToc);
      }
    },
    { passive: true }
  );
  initToc();
  document.addEventListener('astro:page-load', initToc);
</script>
