---
interface Props {
  href: string;
  date: string;
  title: string;
  tag: string;
  excerpt?: string;
  readTime?: string;
  cover?: string | null;
}

const { href, date, title, tag, excerpt, readTime, cover = null } = Astro.props;
---

<a
  href={href}
  class="group flex items-start sm:items-center gap-4 sm:gap-6 px-4 py-5 cursor-pointer transition-colors duration-150 border-b border-border border-l-2 border-l-transparent hover:bg-surface hover:border-l-accent-ink no-underline"
>
  <span class="hidden sm:block font-mono text-[11px] text-text-3 w-20 flex-shrink-0">{date}</span>

  <span class="hidden sm:flex items-center justify-center relative w-[88px] h-[56px] flex-shrink-0 overflow-hidden rounded-[3px] border border-border bg-surface-2">
    {
      cover ? (
        <img
          src={cover}
          alt=""
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover opacity-80 transition-all duration-300 group-hover:opacity-100 group-hover:scale-105"
        />
      ) : (
        <span class="font-mono text-accent-ink text-sm opacity-50 transition-opacity duration-300 group-hover:opacity-100">✦</span>
      )
    }
  </span>

  <div class="flex-1 min-w-0">
    <!-- mobile: meta arriba del título -->
    <div class="flex sm:hidden items-center gap-2 mb-2 font-mono text-[10px] text-text-3">
      <span>{date}</span>
      {readTime && <span>· {readTime}</span>}
      <span class="ml-auto text-[8px] tracking-[3px] uppercase px-2 py-0.5 text-accent-ink border border-accent-ink rounded-[2px]">
        {tag}
      </span>
    </div>
    <p class="text-white text-base font-semibold leading-snug">{title}</p>
    {excerpt && <p class="text-text-2 text-[12px] mt-1 line-clamp-2 sm:line-clamp-1">{excerpt}</p>}
  </div>

  {readTime && <span class="hidden sm:block font-mono text-text-3 flex-shrink-0 text-[10px]">{readTime}</span>}

  <span
    class="hidden sm:block font-mono text-[8px] tracking-[3px] uppercase px-2 py-1 flex-shrink-0 text-accent-ink border border-accent-ink rounded-[2px]"
  >
    {tag}
  </span>

  <span
    class="hidden sm:block text-accent-ink text-sm font-mono flex-shrink-0 opacity-0 -translate-x-1 transition-all duration-150 group-hover:opacity-100 group-hover:translate-x-0"
  >
    →
  </span>
</a>
