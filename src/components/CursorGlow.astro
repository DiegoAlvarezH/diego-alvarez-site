<div
  id="cursor-glow"
  class="pointer-events-none fixed z-30 transition-opacity duration-300 opacity-0 -translate-x-1/2 -translate-y-1/2"
  style="width: 500px; height: 500px; background: radial-gradient(circle, rgba(168,255,71,0.06) 0%, transparent 60%); left: -200px; top: -200px;"
  aria-hidden="true"
>
</div>

<script>
  if (!window.matchMedia('(pointer: coarse)').matches) {
    window.addEventListener('mousemove', (e) => {
      const glow = document.getElementById('cursor-glow');
      if (!glow) return;
      glow.style.left = `${e.clientX}px`;
      glow.style.top = `${e.clientY}px`;
      glow.style.opacity = '1';
    });
    window.addEventListener('mouseout', () => {
      const glow = document.getElementById('cursor-glow');
      if (glow) glow.style.opacity = '0';
    });
  }
</script>
