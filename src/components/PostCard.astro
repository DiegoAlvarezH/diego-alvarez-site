---
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

interface Props {
  href: string;
  title: string;
  excerpt: string;
  tag: string;
  date: string;
  readTime: string;
  cover?: string | null;
}

const { href, title, excerpt, tag, date, readTime, cover = null } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<a
  href={href}
  class="group flex flex-col h-full bg-surface border border-border rounded-[4px] overflow-hidden transition-all duration-200 hover:border-accent-ink hover:-translate-y-1 no-underline"
>
  <div class="relative aspect-[16/9] overflow-hidden bg-surface-2 border-b border-border">
    {
      cover ? (
        <img
          src={cover}
          alt=""
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover opacity-85 transition-all duration-500 group-hover:opacity-100 group-hover:scale-[1.05]"
        />
      ) : (
        <div
          class="absolute inset-0 flex items-center justify-center font-mono text-accent-ink text-3xl"
          style="background: radial-gradient(circle at 70% 30%, rgba(168,255,71,0.12) 0%, transparent 60%);"
        >
          ✦
        </div>
      )
    }
    <span
      class="absolute top-3 left-3 font-mono text-[8px] tracking-[3px] uppercase px-2 py-1 text-accent border border-accent rounded-[2px] bg-black/70 backdrop-blur-sm"
    >
      {tag}
    </span>
  </div>

  <div class="flex flex-col flex-1 p-5">
    <div class="flex items-center gap-3 font-mono text-text-3 text-[10px]">
      <span>{date}</span>
      <span class="flex items-center gap-1"><Icon name="clock" size={10} />{readTime}</span>
    </div>
    <h3 class="text-white text-[15px] font-semibold leading-snug mt-2">{title}</h3>
    <p class="text-text-2 text-[13px] leading-relaxed mt-2 line-clamp-3">{excerpt}</p>
    <span class="mt-auto pt-4 text-accent-ink font-mono text-sm flex items-center gap-1 transition-transform duration-150 group-hover:translate-x-1">
      {t('blog.read')}
      <Icon name="arrow-right" size={14} />
    </span>
  </div>
</a>
