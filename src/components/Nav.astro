---
import Icon from './Icon.astro';
import { getLangFromUrl, useTranslations, localePath, switchLangPath } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const other = switchLangPath(Astro.url);

const links = [
  { label: t('nav.home'), to: localePath(lang, '/') },
  { label: t('nav.blog'), to: localePath(lang, '/blog') },
  { label: t('nav.cv'), to: localePath(lang, '/cv') },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (to: string) => (to.replace(/\/$/, '') || '/') === path;
---

<header
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 md:px-8 py-5 transition-all duration-300 border-b border-transparent"
>
  <a
    href={localePath(lang, '/')}
    class="font-mono text-xs font-semibold tracking-widest text-white uppercase select-none hover:text-accent transition-colors duration-200"
  >
    D · ALVAREZ
  </a>

  <nav
    class="hidden md:flex items-center gap-6 px-6 py-2.5 rounded-full"
    style="background: color-mix(in srgb, var(--c-text-1) 5%, transparent); border: 1px solid color-mix(in srgb, var(--c-text-1) 8%, transparent); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);"
  >
    {
      links.map((link) => (
        <a
          href={link.to}
          class:list={[
            'font-mono text-[10px] tracking-[3px] uppercase transition-colors duration-150 relative',
            isActive(link.to) ? 'text-white' : 'text-text-3 hover:text-text-2',
          ]}
        >
          {link.label}
          {isActive(link.to) && (
            <span class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-accent" />
          )}
        </a>
      ))
    }
  </nav>

  <div class="flex items-center gap-3">
    <!-- Toggle tema oscuro/claro -->
    <button
      id="theme-toggle"
      aria-label={t('nav.theme')}
      title={t('nav.theme')}
      class="flex items-center justify-center text-text-2 border border-border p-2.5 rounded-[2px] hover:border-accent hover:text-accent transition-colors duration-200"
    >
      <!-- muestra el ícono del tema opuesto al activo -->
      <span class="theme-icon-sun"><Icon name="sun" size={13} /></span>
      <span class="theme-icon-moon hidden"><Icon name="moon" size={13} /></span>
    </button>

    <!-- Toggle idioma ES/EN -->
    <a
      href={other.href}
      aria-label={t('nav.lang')}
      title={t('nav.lang')}
      class="flex items-center gap-2 font-mono text-[10px] font-semibold tracking-[2px] uppercase text-text-2 border border-border px-3 py-2.5 rounded-[2px] hover:border-accent hover:text-accent transition-colors duration-200"
    >
      <Icon name="globe" size={13} />
      <span>
        <span class:list={[lang === 'es' ? 'text-accent' : '']}>ES</span>
        <span class="text-text-3 mx-0.5">/</span>
        <span class:list={[lang === 'en' ? 'text-accent' : '']}>EN</span>
      </span>
    </a>

    <a
      href={localePath(lang, '/cv')}
      class="hidden md:block font-mono text-[10px] font-semibold tracking-[3px] uppercase bg-accent text-black px-5 py-2.5 rounded-[2px] hover:bg-accent-dark hover:scale-[1.03] active:scale-[0.97] transition-all duration-200"
    >
      {t('nav.contact')}
    </a>

    <button
      id="mobile-toggle"
      class="md:hidden text-white"
      aria-label={t('nav.menu')}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="menu-open"><Icon name="menu" size={22} /></span>
      <span class="menu-close hidden"><Icon name="x" size={22} /></span>
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed top-[64px] left-0 right-0 z-40 md:hidden bg-bg backdrop-blur-lg border-b border-border hidden"
>
  <nav class="flex flex-col px-6 py-6 gap-4">
    {
      links.map((link) => (
        <a
          href={link.to}
          class:list={[
            'font-mono text-sm tracking-[3px] uppercase transition-colors',
            isActive(link.to) ? 'text-accent' : 'text-text-2',
          ]}
        >
          {link.label}
        </a>
      ))
    }
    <a
      href={localePath(lang, '/cv')}
      class="font-mono text-xs font-semibold tracking-[3px] uppercase bg-accent text-black px-5 py-3 mt-2 rounded-[2px] text-center"
    >
      {t('nav.contact')}
    </a>
  </nav>
</div>

<script>
  // Listener global único: consulta el DOM en cada scroll (sobrevive a View Transitions)
  const onScroll = () => {
    const header = document.getElementById('site-nav');
    if (!header) return;
    const scrolled = window.scrollY > 50;
    header.style.borderBottomColor = scrolled ? 'var(--c-border)' : 'transparent';
    header.style.background = scrolled
      ? 'color-mix(in srgb, var(--c-bg) 60%, transparent)'
      : 'transparent';
    header.style.backdropFilter = scrolled ? 'blur(12px)' : 'none';
    (header.style as CSSStyleDeclaration & { webkitBackdropFilter?: string }).webkitBackdropFilter =
      scrolled ? 'blur(12px)' : 'none';
  };
  window.addEventListener('scroll', onScroll, { passive: true });

  // Los nodos del menú se reemplazan en cada navegación → re-attach por página
  function initNav() {
    onScroll();
    // Persistir el idioma que se está viendo (ClientRouter actualiza <html lang>)
    try {
      localStorage.setItem('lang', document.documentElement.lang || 'es');
    } catch {
      /* storage no disponible */
    }
    const toggle = document.getElementById('mobile-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.querySelector('.menu-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.menu-close')?.classList.toggle('hidden', !open);
    };
    toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

    initThemeToggle();
  }

  // Toggle de tema: el atributo data-theme lo aplica el script inline de BaseLayout
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    const syncIcons = () => {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      // Mostrar el ícono del estado opuesto: en dark → sol, en light → luna
      btn.querySelector('.theme-icon-sun')?.classList.toggle('hidden', isLight);
      btn.querySelector('.theme-icon-moon')?.classList.toggle('hidden', !isLight);
    };
    syncIcons();

    btn.addEventListener('click', () => {
      const next =
        document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage no disponible */
      }
      syncIcons();
    });
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
